                <mxCell id="architektura:ad.mongo" value="&lt;b&gt;adapter/spi/nonrelational&lt;/b&gt;&lt;br&gt;PyMongo · ClientSession.with_transaction · mapowanie dokument ↔ encja · &lt;b&gt;ten model&lt;/b&gt;" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#8fd19e;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=3;" vertex="1" parent="architektura-1">
