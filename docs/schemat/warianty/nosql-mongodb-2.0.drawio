                <mxCell id="architektura:ad.obj" value="&lt;b&gt;adapter/spi/object_relational&lt;/b&gt;&lt;br&gt;psycopg + ręczny SQL: typy złożone, ENUM, domeny" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#8a9bb0;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1;" vertex="1" parent="architektura-1">
