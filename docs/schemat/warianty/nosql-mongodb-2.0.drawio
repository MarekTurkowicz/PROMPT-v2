                <mxCell id="architektura:e.impl.obj" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=0;endSize=12;strokeColor=#7fb2e8;strokeWidth=1.2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="architektura-1" source="architektura:ad.obj" target="architektura:hex.spi">
