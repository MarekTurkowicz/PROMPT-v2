    <diagram id="architektura" name="2. Heksagon, ograniczenia, mapowanie">
        <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#1e1f22">
            <root>
                <mxCell id="architektura-0" />
                <mxCell id="architektura-1" parent="architektura-0" />
                <mxCell id="architektura:title" value="PROMT 2.0 – MongoDB w architekturze heksagonalnej: ograniczenia i decyzje w modelu" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=22;fontColor=#e6edf3;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="40" y="16" width="2600" height="40" as="geometry" />
                </mxCell>
                <mxCell id="architektura:subtitle" value="Układ katalogów wg szkieletu backend/app/ na main (PRD 2.0, rozdz. 6 i 12). Ta sama domena i te same porty dla trzech wariantów bazy; wybór adaptera przy starcie aplikacji." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=12;fontColor=#9aa8b6;" vertex="1" parent="architektura-1">
                    <mxGeometry x="40" y="56" width="1560" height="40" as="geometry" />
                </mxCell>
                <mxCell id="architektura:driving" value="&lt;b&gt;adapter/api&lt;/b&gt; (wejście)&lt;br&gt;&lt;br&gt;Django + DRF: widoki, uwierzytelnianie (simplejwt), polecenia manage.py (seed).&lt;br&gt;&lt;br&gt;Serializuje DTO z ports/api (Serializer / Pydantic) – bez ModelSerializer na encjach domeny." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#8a9bb0;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;" vertex="1" parent="architektura-1">
                    <mxGeometry x="40" y="290" width="250" height="230" as="geometry" />
                </mxCell>
                <mxCell id="architektura:hex.ports" value="aplikacja (app/)" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=90;html=1;whiteSpace=wrap;fillColor=#22303f;strokeColor=#7fb2e8;strokeWidth=2;fontColor=#e6edf3;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="architektura-1">
                    <mxGeometry x="330" y="140" width="640" height="520" as="geometry" />
                </mxCell>
                <mxCell id="architektura:hex.api" value="&lt;b&gt;&lt;span style=&quot;color:#7fb2e8&quot;&gt;ports/api&lt;/span&gt;&lt;/b&gt;&lt;br&gt;przypadki użycia&lt;br&gt;(P1–P12 + zapytania widoków)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#e6edf3;" vertex="1" parent="architektura-1">
                    <mxGeometry x="350" y="340" width="140" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:hex.spi" value="&lt;b&gt;&lt;span style=&quot;color:#7fb2e8&quot;&gt;ports/spi&lt;/span&gt;&lt;/b&gt;&lt;br&gt;repozytoria,&lt;br&gt;UnitOfWork,&lt;br&gt;IdGenerator,&lt;br&gt;ReportQueries" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#e6edf3;" vertex="1" parent="architektura-1">
                    <mxGeometry x="810" y="322" width="140" height="92" as="geometry" />
                </mxCell>
                <mxCell id="architektura:hex.domain" value="&lt;b&gt;domain/entities + service/&lt;/b&gt;&lt;br&gt;&lt;br&gt;Organization · Member · Group · Project · Funding · Task · TimeEntry · Comment · Expense · ActivityLog · Notification&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#9aa8b6&quot;&gt;czysty Python (dataclasses), id: int; bez importów Django i PyMongo&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=60;html=1;whiteSpace=wrap;fillColor=#2c2440;strokeColor=#c9a7f5;strokeWidth=2;fontColor=#e6edf3;fontSize=11;verticalAlign=middle;spacingLeft=40;spacingRight=40;" vertex="1" parent="architektura-1">
                    <mxGeometry x="470" y="270" width="360" height="260" as="geometry" />
                </mxCell>
                <mxCell id="architektura:ad.rel" value="&lt;b&gt;adapter/spi/relational&lt;/b&gt;&lt;br&gt;Django ORM (api/models) · transaction.atomic" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#8a9bb0;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;strokeWidth=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1030" y="170" width="310" height="120" as="geometry" />
                </mxCell>
                <mxCell id="architektura:db.rel" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;schemat relacyjny (22 tabele)&lt;br&gt;+ user i tabele Django" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#2d3137;strokeColor=#f0a35e;strokeWidth=2;fontColor=#e6edf3;fontSize=11;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1400" y="165" width="230" height="130" as="geometry" />
                </mxCell>
                <mxCell id="architektura:e.impl.rel" value="&lt;span style=&quot;color:#9aa8b6;font-size:10px&quot;&gt;implementuje&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=0;endSize=12;strokeColor=#7fb2e8;strokeWidth=1.2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="architektura-1" source="architektura:ad.rel" target="architektura:hex.spi">
