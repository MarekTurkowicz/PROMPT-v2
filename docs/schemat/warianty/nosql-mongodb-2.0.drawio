                    <mxGeometry height="117" width="760" x="800" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="atomicity.h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=16;fontColor=#172B3A;fontStyle=1;" value="1 / Granice transakcji" vertex="1">
                    <mxGeometry height="32" width="740" x="810" y="157" as="geometry"/>
                </mxCell>
                <mxCell id="atomicity.body" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=14;fontColor=#172B3A;fontStyle=0;" value="Jeden dokument jest granicą atomowego zapisu. Zmiana kilku dokumentów, dziennik i powiadomienia wymagają wspólnej sesji i transakcji MongoDB. Środowisko lokalne: jednowęzłowy replica set rs0; nie zapewnia on wysokiej dostępności." vertex="1">
                    <mxGeometry height="69" width="740" x="810" y="193" as="geometry"/>
                </mxCell>
                <mxCell id="references" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;fillColor=#F5F7F8;strokeColor=#C5CED5;" value="" vertex="1">
                    <mxGeometry height="136" width="760" x="800" y="287" as="geometry"/>
                </mxCell>
                <mxCell id="references.h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=16;fontColor=#172B3A;fontStyle=1;" value="2 / Odwołania i współbieżność" vertex="1">
                    <mxGeometry height="32" width="740" x="810" y="294" as="geometry"/>
                </mxCell>
                <mxCell id="references.body" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=14;fontColor=#172B3A;fontStyle=0;" value="Serwis sprawdza istnienie obiektu, organizację i regułę usuwania. Dodawanie odwołania i usuwanie rodzica muszą zapisywać wspólny dokument strażnika w transakcji. Sam odczyt liczby odwołań nie zabezpiecza przed wyścigiem. Pole version służy do kontroli konfliktów zapisu agregatu." vertex="1">
                    <mxGeometry height="88" width="740" x="810" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="copies" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;fillColor=#F5F7F8;strokeColor=#C5CED5;" value="" vertex="1">
                    <mxGeometry height="117" width="760" x="800" y="443" as="geometry"/>
                </mxCell>
                <mxCell id="copies.h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=16;fontColor=#172B3A;fontStyle=1;" value="3 / Kopie i odczyty" vertex="1">
                    <mxGeometry height="32" width="740" x="810" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="copies.body" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=14;fontColor=#172B3A;fontStyle=0;" value="Kopie organization_id, status_category i identyfikatorów raportowych ograniczają potrzebę łączenia kolekcji. Zmiana źródła wymaga aktualizacji zależnych kopii. Raporty korzystają z agregacji; $lookup jest dostępny, gdy potrzebne są dane z innej kolekcji." vertex="1">
                    <mxGeometry height="69" width="740" x="810" y="486" as="geometry"/>
                </mxCell>
                <mxCell id="boundaries" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;fillColor=#F5F7F8;strokeColor=#C5CED5;" value="" vertex="1">
                    <mxGeometry height="117" width="760" x="800" y="580" as="geometry"/>
                </mxCell>
                <mxCell id="boundaries.h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=16;fontColor=#172B3A;fontStyle=1;" value="4 / Izolacja danych i PostgreSQL" vertex="1">
                    <mxGeometry height="32" width="740" x="810" y="587" as="geometry"/>
                </mxCell>
                <mxCell id="boundaries.body" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=14;fontColor=#172B3A;fontStyle=0;" value="Zapytania do danych organizacji wymagają sprawdzenia uprawnień i filtra organizacji. Wyjątki: współdzielone fundings i skrzynka filtrowana po recipient_user_id. MongoDB nie wymusza odwołań do user w PostgreSQL; operacje w dwóch bazach wymagają osobnej koordynacji." vertex="1">
                    <mxGeometry height="69" width="740" x="810" y="623" as="geometry"/>
                </mxCell>
                <mxCell id="limits" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;fillColor=#F5F7F8;strokeColor=#C5CED5;" value="" vertex="1">
                    <mxGeometry height="136" width="760" x="800" y="717" as="geometry"/>
                </mxCell>
                <mxCell id="limits.h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=16;fontColor=#172B3A;fontStyle=1;" value="5 / Rozmiar, retencja i sharding" vertex="1">
                    <mxGeometry height="32" width="740" x="810" y="724" as="geometry"/>
                </mxCell>
                <mxCell id="limits.body" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=14;fontColor=#172B3A;fontStyle=0;" value="Dokument BSON ma limit 16 MiB. Limity tablic nie zastępują kontroli rozmiaru, zwłaszcza dla opisów i historii. Pliki są poza bazą; metadane dopuszczają do 50 MiB na plik. TTL usuwa dane w tle, z możliwym opóźnieniem. Sharding wymaga osobnego projektu kluczy i indeksów; obecny wariant nie jest shardowany." vertex="1">
                    <mxGeometry height="88" width="740" x="810" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="types" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;fillColor=#F5F7F8;strokeColor=#C5CED5;" value="" vertex="1">
                    <mxGeometry height="136" width="760" x="800" y="873" as="geometry"/>
                </mxCell>
                <mxCell id="types.h" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=16;fontColor=#172B3A;fontStyle=1;" value="6 / Typy i walidacja" vertex="1">
                    <mxGeometry height="32" width="740" x="810" y="880" as="geometry"/>
                </mxCell>
                <mxCell id="types.body" parent="1" style="html=1;whiteSpace=wrap;rounded=0;shadow=0;fontFamily=Arial;fontColor=#172B3A;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=6;fontSize=14;fontColor=#172B3A;fontStyle=0;" value="integer = BSON int lub long; int = BSON int32. string(N) oznacza maksymalną długość. decimal128(p,s) to Decimal128 z limitem i krokiem narzuconym walidatorem, nie osobny typ BSON. date to BSON Date; dni kalendarzowe zapisujemy jako 00:00 UTC. Każda kolekcja ma domyślny unikalny indeks _id." vertex="1">
                    <mxGeometry height="88" width="740" x="810" y="916" as="geometry"/>
                </mxCell>
