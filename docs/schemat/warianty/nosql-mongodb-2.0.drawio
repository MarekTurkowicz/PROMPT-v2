                    </mxGeometry>
                </mxCell>
                <mxCell id="architektura:composition" value="&lt;b&gt;adapter/dependencies_container.py&lt;/b&gt; – składa zależności przy starcie (AppConfig.ready). Implementacje ports/spi wybiera zmienna DATA_BACKEND = relational | object_relational | nonrelational &lt;span style=&quot;color:#ff8a80&quot;&gt;⚠ D9 – propozycja nazwy&lt;/span&gt;." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#e6edf3;" vertex="1" parent="architektura-1">
                    <mxGeometry x="330" y="690" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:spi" value="&lt;b&gt;ports/spi – 1 agregat = 1 dokument MongoDB = 1 repozytorium&lt;/b&gt;&lt;br&gt;OrganizationRepository · MemberRepository · GroupRepository · ProjectRepository · FundingRepository · TaskRepository · TimeEntryRepository · CommentRepository · ExpenseRepository · ActivityLogRepository · NotificationRepository · &lt;b&gt;ReportQueries&lt;/b&gt; (tylko odczyt: dashboardy, kondycja, porównanie osób, raporty – potok agregacji; D8)&lt;br&gt;+ &lt;b&gt;UnitOfWork&lt;/b&gt; (transakcja przez wiele repozytoriów) + &lt;b&gt;IdGenerator&lt;/b&gt; (PG: nextval sekwencji, MongoDB: counters)&lt;br&gt;&lt;br&gt;Adaptery relacyjne rozkładają agregat na tabele (Project → project + milestone + project_funding + task_status). Kontrakt portu to encje domeny i DTO – nigdy QuerySet ani surowy dokument BSON." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#7fb2e8;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;" vertex="1" parent="architektura-1">
                    <mxGeometry x="330" y="790" width="640" height="130" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.title" value="Ograniczenie → decyzja w modelu MongoDB" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=15;fontColor=#e6edf3;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="90" width="984" height="34" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.h.0" value="#" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#33373e;strokeColor=#4a525e;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fontStyle=1;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="128" width="44" height="30" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.h.1" value="Ograniczenie (projekt / Django / MongoDB)" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#33373e;strokeColor=#4a525e;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fontStyle=1;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="128" width="300" height="30" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.h.2" value="Decyzja w modelu" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#33373e;strokeColor=#4a525e;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fontStyle=1;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="128" width="640" height="30" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.1.0" value="1" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="158" width="44" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.1.1" value="Django ORM nie obsłuży tu MongoDB (PRD 2.0, 6.4)" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="158" width="300" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.1.2" value="Adapter adapter/spi/nonrelational na PyMongo, poza DATABASES. Mapuje dokument ↔ encję domeny bez modeli Django. django-mongodb-backend nie pasuje: zakłada klucze ObjectId, a domena i dwa pozostałe adaptery mają id bigint." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="158" width="640" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.2.0" value="2" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="218" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.2.1" value="Konto i logowanie są w Django: AUTH_USER_MODEL, admin, sesje, JWT" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="218" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.2.2" value="user i tabele Django zostają w PostgreSQL we wszystkich wariantach. W MongoDB tylko members.user_id i notifications.recipient_user_id (⇢, bez spójności) oraz kopia display_name." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="218" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.3.0" value="3" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="264" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.3.1" value="Brak autoincrement; trzy adaptery za jednym portem" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="264" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.3.2" value="_id: long z kolekcji counters ($inc; przy wsadach rezerwacja zakresu, np. P1). Ten sam typ id co bigint w PG: te same testy portów, adresy API i seed dla trzech baz." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="264" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.4.0" value="4" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="310" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.4.1" value="Brak kluczy obcych i on_delete" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="310" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.4.2" value="Spójność odwołań sprawdza serwis / adapter przy zapisie. PROTECT = countDocuments przed usunięciem; CASCADE / SET_NULL = deleteMany / updateMany w tej samej transakcji." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="310" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.5.0" value="5" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="356" width="44" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.5.1" value="Transakcje wielodokumentowe działają tylko na replica secie" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="356" width="300" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.5.2" value="MongoDB w docker-compose jako 1-węzłowy replica set rs0. Port UnitOfWork: transaction.atomic / transakcja psycopg / ClientSession.with_transaction. P1: $push do projects.fundings + counters + insertMany zadań – w całości albo wcale." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="356" width="640" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.6.0" value="6" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="416" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.6.1" value="CHECK" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="416" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.6.2" value="Walidator kolekcji: $jsonSchema (typy BSON, enumy, wzorce, oneOf dla „dokładnie jedno z”) + $expr (porównania pól, np. end ≥ start). validationLevel: strict, validationAction: error. Długości i precyzja jak varchar / numeric w PG." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="416" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.7.0" value="7" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="462" width="44" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.7.1" value="UNIQUE, także warunkowe" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="462" width="300" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.7.2" value="Indeksy unikalne i częściowe (partialFilterExpression). Unikalności wewnątrz tablicy jednego dokumentu (nazwa roli / statusu, jeden domyślny status, jedno główne finansowanie) indeks nie zapewni – unikalny multikey działa między dokumentami → $expr w walidatorze (porównanie rozmiaru tablicy z $setUnion); błąd zapisu 121 adapter mapuje na błąd domeny. Filtry częściowe: warunek zakresowy (≥ 0 / ≥ '') zamiast $type." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="462" width="640" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.8.0" value="8" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="522" width="44" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.8.1" value="Brak RLS; izolacja organizacji (PRD §6)" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="522" width="300" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.8.2" value="organization_id w każdym dokumencie domeny (także tam, gdzie PG ma go pośrednio) i na początku każdego indeksu. Bazowa klasa repozytorium zawsze dokłada filtr. To też klucz shardu. Wyjątek: notifications (odbiorcą jest konto; organization_id opcjonalne – ⚠ #72)." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="522" width="640" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.9.0" value="9" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="582" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.9.1" value="Limit 16 MB na dokument" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="582" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.9.2" value="Osadzamy tylko tablice ograniczone (max N w domenie). Dane rosnące bez końca – wpisy czasu, komentarze, wydatki, historia, powiadomienia – to osobne kolekcje." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="582" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.10.0" value="10" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="628" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.10.1" value="Kopie danych trzeba utrzymywać" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="628" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.10.2" value="© tylko dla pól niezmiennych lub rzadko zmienianych: status_category (kategoria statusu niezmienna – reguła domeny), organization_id, odwołania w time_entries i expenses, display_name. Każda kopia ma wskazane źródło." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="628" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.11.0" value="11" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="674" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.11.1" value="Repozytorium zapisuje cały agregat" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="674" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.11.2" value="version: int (Z13) w korzeniach z tablicami; zapis updateOne({_id, version}) z $inc version, brak trafienia = konflikt współbieżności. Dla zgodności portu ta sama kolumna w PG." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="674" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.12.0" value="12" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="720" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.12.1" value="Typy Pythona i Django" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="720" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.12.2" value="Decimal → decimal128 (adapter: bson.Decimal128 ↔ decimal.Decimal); DateField → date o 00:00 UTC; FileField → klucz pliku w storage, w dokumencie tylko metadane." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="720" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.13.0" value="13" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="766" width="44" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.13.1" value="DRF ModelSerializer działa tylko na ORM" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="766" width="300" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.13.2" value="adapter/api serializuje DTO z ports/api (Serializer albo Pydantic), niezależnie od bazy. Serwisy nie przyjmują i nie zwracają QuerySet (analiza, S4)." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="766" width="640" height="46" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.14.0" value="14" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1700" y="812" width="44" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.14.1" value="Brak JOIN – $lookup jest drogi" style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;fontStyle=1;" vertex="1" parent="architektura-1">
                    <mxGeometry x="1744" y="812" width="300" height="60" as="geometry" />
                </mxCell>
                <mxCell id="architektura:tab.14.2" value="Model pod odczyt: karta zadania = 1 dokument; Kanban = 1 zapytanie po tasks + statusy z dokumentów projektu i firmy; effective_roles = 1 potok (members → $lookup groups → $lookup przodków) (NFR-PERF-03, B7); raporty czasu i budżetu = $group po skopiowanych polach (port ReportQueries; brak liczników w dokumentach)." style="rounded=1;arcSize=3;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;arcSize=0;rounded=0;" vertex="1" parent="architektura-1">
                    <mxGeometry x="2044" y="812" width="640" height="60" as="geometry" />
                </mxCell>
