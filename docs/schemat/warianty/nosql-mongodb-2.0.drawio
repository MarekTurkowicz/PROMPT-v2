                <mxCell id="architektura:db.mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;MongoDB 9.0 (zgodny od 7.0)&lt;br&gt;replica set rs0 (1 węzeł)&lt;br&gt;11 kolekcji + counters" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#2d3137;strokeColor=#8fd19e;strokeWidth=2;fontColor=#e6edf3;fontSize=11;" vertex="1" parent="architektura-1">
