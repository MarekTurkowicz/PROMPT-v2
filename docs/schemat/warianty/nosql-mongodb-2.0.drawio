    <diagram id="kolekcje" name="1. Kolekcje MongoDB">
        <mxGraphModel dx="1281" dy="1098" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2800" pageHeight="2400" background="#1e1f22" math="0" shadow="0">
            <root>
                <mxCell id="kolekcje-0" />
                <mxCell id="kolekcje-1" parent="kolekcje-0" />
                <mxCell id="kolekcje:title" parent="kolekcje-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=22;fontColor=#e6edf3;fontStyle=1;" value="PROMT 2.0 – model NoSQL (MongoDB ≥ 7.0, testowany na 7.0 / 8.0 / 9.0) · adapter/spi/nonrelational" vertex="1">
                    <mxGeometry height="40" width="2630" x="40" y="16" as="geometry" />
                </mxCell>
                <mxCell id="kolekcje:subtitle" parent="kolekcje-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=12;fontColor=#9aa8b6;" value="1 agregat domeny = 1 dokument = 1 repozytorium w ports/spi.  22 tabele PostgreSQL → 11 kolekcji + counters.  Konto (user) i tabele Django zostają w PostgreSQL.  Podstawa: nosql-mongodb-heksagonalny.drawio + zmiany Z1–Z14 (2026-11-06), potem zgodność z docs/PRD-promt-2.0.md i modelami Django – PRD-first ◆ (2026-11-09). Źródło prawdy: backend/app/adapter/spi/nonrelational/models.  Strona 2: heksagon, ograniczenia, mapowanie tabel.  Strona 3: lista zmian i porównanie z modelem relacyjnym." vertex="1">
                    <mxGeometry height="44" width="2630" x="40" y="56" as="geometry" />
                </mxCell>
                <mxCell id="kolekcje:pg.zone" parent="kolekcje-1" style="rounded=1;arcSize=4;absoluteArcSize=1;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=#26221d;strokeColor=#f0a35e;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#f0a35e;fontStyle=1;fontSize=13;" value="PostgreSQL · baza Django" vertex="1">
                    <mxGeometry height="240" width="850" x="40" y="120" as="geometry" />
                </mxCell>
                <mxCell id="kolekcje:pg.note" parent="kolekcje:pg.zone" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#e6edf3;" value="&lt;b&gt;Zawsze w PostgreSQL&lt;/b&gt;, niezależnie od DATA_BACKEND: konto &lt;b&gt;user&lt;/b&gt; (AUTH_USER_MODEL – logowanie, admin, JWT) i tabele wbudowane Django.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#f0a35e&quot;&gt;⇢&lt;/span&gt; odwołanie między bazami nie ma żadnej spójności: adapter sprawdza konto przy dodaniu członka, a usunięcie konta (RODO, NFR-AUD-03) musi sprawdzić &lt;b&gt;members&lt;/b&gt; i &lt;b&gt;notifications&lt;/b&gt; w MongoDB – w PG robił to PROTECT.&lt;br&gt;&lt;br&gt;MongoDB trzyma wyłącznie dane domeny." vertex="1">
                    <mxGeometry height="160" width="426" x="6" y="34" as="geometry" />
                </mxCell>
