    <diagram id="mechanizmy" name="2. Mechanizmy i decyzje">
        <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="2000" background="#1e1f22" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title-60" parent="1" value="Model obiektowo-relacyjny: co to jest i gdzie go używamy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=24;fontStyle=1;fontColor=#e6edf3;" vertex="1">
                    <mxGeometry x="40" y="16" width="3800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="sub-61" parent="1" value="Mechanizmy PostgreSQL, miejsca w PROMT, warstwy architektury i ograniczenia." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=13;fontColor=#9aa8b6;" vertex="1">
                    <mxGeometry x="40" y="58" width="3800" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="b-62" parent="1" value="&lt;b style=&#39;font-size:15px&#39;&gt;Model obiektowo-relacyjny w 6 punktach&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1.&lt;/b&gt; Baza relacyjna (tabele, klucze obce, SQL, transakcje) + elementy obiektowe ze standardu SQL:1999.&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; Komórka może trzymać wartość złożoną: obiekt z polami, tablicę obiektów albo typ z regułami. 1NF łamiemy tylko tam, gdzie część nie istnieje bez całości.&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Obiekty upraszczają wnętrze agregatu (zadanie + checklista + załączniki). Powiązania między agregatami zostają relacyjne – PostgreSQL nie ma REF z Oracle.&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Używamy: ENUM, DOMAIN, typów złożonych, tablic; jsonb bez zmian; funkcje i trigger tylko jako ochrona danych.&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; Koszt: ORM Django tego nie zna → schemat jako obiekty Pythona z SQL (&lt;code&gt;migrate_or&lt;/code&gt;), repozytoria na psycopg i ręcznym SQL.&lt;br/&gt;&lt;b&gt;6.&lt;/b&gt; Hipoteza H4: więcej reguł pilnuje baza, mniej złączeń – kosztem migracji typów i narzędzi." style="rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1">
                    <mxGeometry x="40" y="120" width="1180" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="b-63" parent="1" value="&lt;b style=&#39;font-size:15px&#39;&gt;Gdzie to leży (architektura z main, dc52156)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px;color:#e6edf3&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:5px 8px;border-bottom:1px solid #5d6875;color:#8794a3;font-size:11px&quot;&gt;Miejsce&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:5px 8px;border-bottom:1px solid #5d6875;color:#8794a3;font-size:11px&quot;&gt;Zawartość&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;&lt;span style=&quot;font-family:Courier New;color:#e6edf3&quot;&gt;app/&amp;lt;moduł&amp;gt;/core/domain&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;reguły biznesowe, value objects, enumy – źródło prawdy (np. katalog uprawnień)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;&lt;span style=&quot;font-family:Courier New;color:#e6edf3&quot;&gt;app/&amp;lt;moduł&amp;gt;/core/application&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;przypadki użycia, wartości domyślne, reguły między tabelami&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;&lt;span style=&quot;font-family:Courier New;color:#e6edf3&quot;&gt;app/&amp;lt;moduł&amp;gt;/adapter/outbound/object_relational_db/schema&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;obiekty tabel modułu (ENUM, DOMAIN lokalne, Table, Statement); później obok repositories/ + mappers/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;&lt;span style=&quot;font-family:Courier New;color:#e6edf3&quot;&gt;app/shared/adapter/outbound/object_relational_db&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;bloki EnumType/Domain/Table/Statement, wspólne domeny i typy złożone, migrate.py&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;&lt;span style=&quot;font-family:Courier New;color:#e6edf3&quot;&gt;app/object_relational_schema.py&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;border-bottom:1px solid #33373e;vertical-align:top&quot;&gt;SCHEMA_OBJECTS w kolejności tworzenia + MIGRATIONS (jak app/models.py)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br/&gt;&lt;b&gt;Zasada:&lt;/b&gt; reguła w bazie to druga linia obrony – nigdy ostrzejsza niż w domenie, inaczej dane z innej bazy nie wejdą." style="rounded=1;arcSize=6;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#23262b;strokeColor=#3a4049;fontColor=#e6edf3;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1">
                    <mxGeometry x="1260" y="120" width="1180" height="330" as="geometry"/>
                </mxCell>
